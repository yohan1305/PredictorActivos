@model Aplicacion.ViewModels.PrediccionFormularioViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Análisis de Activos";
    var resultado = ViewBag.Resultado as Aplicacion.Dtos.PrediccionResponseDto;
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-10">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold text-dark">Predictor de Tendencias</h1>
            <p class="lead text-muted">Ingresa los datos históricos para calcular la proyección de mercado.</p>
            <span class="badge bg-primary px-3 py-2 rounded-pill">
                <i class="bi bi-cpu me-1"></i> Modo: @ViewBag.ModoUsado
            </span>
        </div>

        <div class="card shadow-sm mb-5">
            <div class="card-body p-4">
                <form asp-action="CalcularPrediccion" method="post" id="predictionForm">
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr class="text-center">
                                    <th style="width: 50px">#</th>
                                    <th><i class="bi bi-calendar3"></i> Fecha</th>
                                    <th><i class="bi bi-currency-dollar"></i> Valor del Activo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < 20; i++)
                                {
                                    var dato = Model.Datos.ElementAtOrDefault(i) ?? new Aplicacion.ViewModels.ParDatoViewModel();
                                    <tr>
                                        <td class="text-center fw-bold text-muted">@(i + 1)</td>
                                        <td>
                                            <input type="date" name="Datos[@(i)].Fecha" class="form-control"
                                                   value="@(dato.Fecha == DateTime.MinValue ? "" : dato.Fecha?.ToString("yyyy-MM-dd"))" required />
                                        </td>
                                        <td>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 text-success">$</span>
                                                <input type="number" step="0.01" name="Datos[@(i)].Valor" class="form-control border-start-0"
                                                       value="@(dato.Valor?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "")" required />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-lightning-charge-fill me-2"></i>Generar Proyección
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (resultado != null)
        {
            <div class="card bg-dark text-white shadow-lg animate__animated animate__fadeInUp">
                <div class="card-header border-secondary py-3">
                    <h4 class="mb-0"><i class="bi bi-check-circle-fill text-success me-2"></i>Análisis Completado</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="row">
                        <div class="col-md-6 border-end border-secondary">
                            <p class="text-secondary mb-1">Modelo Utilizado</p>
                            <h5 class="fw-bold text-info">@resultado.ModoUsado</h5>
                        </div>
                        <div class="col-md-6">
                            <p class="text-secondary mb-1">Predicción Final</p>
                            <h3 class="fw-bold text-black">@resultado.ResultadoTexto</h3>
                        </div>
                    </div>

                    @if (resultado.DetallesROC?.Any() == true)
                    {
                        <hr class="my-4 border-secondary">
                        <h5 class="text-start mb-3"><i class="bi bi-bar-chart-steps me-2"></i>Detalles ROC (Rate of Change)</h5>
                        <div class="table-responsive">
                            <table class="table table-dark table-sm">
                                <thead class="text-secondary">
                                    <tr>
                                        <th>Índice</th>
                                        <th>Precio</th>
                                        <th>Variación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in resultado.DetallesROC)
                                    {
                                        <tr>
                                            <td>T-@item.Indice</td>
                                            <td class="fw-bold">$@item.Precio.ToString("F2")</td>
                                            <td>
                                                <span class="@(item.RocTexto.Contains("+") ? "text-success" : "text-danger")">
                                                    @item.RocTexto
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // SweetAlert para notificaciones
        @if (ViewBag.Error != null)
        {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: '¡Oops!',
                    text: '@ViewBag.Error',
                    confirmButtonColor: '#258cfb'
                });
                </text>
        }
        @if (ViewBag.Exito != null)
        {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: '¡Excelente!',
                    text: '@ViewBag.Exito',
                    timer: 2500,
                    showConfirmButton: false
                });
                </text>
        }
    </script>
}